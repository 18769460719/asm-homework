				; calc.asm —— 作业7：日期计算模块 
				; compute：算当月 1 号是星期几（0=周
				日）和当月天数，结果写回数据段�
				� 
				; 内部把 1900 到 year-1 的天数“边加�
				�� mod 7”，避免 16 位累加溢出。 
				 
				        include macros.inc 
			     C	; macros.inc —— 作业7 公共宏定义 
			     C	; 宏汇编：把常用的一段指令序列起
				个名字，展开时直接替换成指令， 
			     C	; 不产生 call/ret 的开销，也不占额�
				�的代码段。 
			     C	 
			     C	; 保存/恢复常用寄存器（打印类过�
				�里反复用到） 
			     C	PUSHALL macro 
			     C	    push ax 
			     C	    push bx 
			     C	    push cx 
			     C	    push dx 
			     C	    push si 
			     C	    push di 
			     C	endm 
			     C	 
			     C	POPALL macro 
			     C	    pop di 
			     C	    pop si 
			     C	    pop dx 
			     C	    pop cx 
			     C	    pop bx 
			     C	    pop ax 
			     C	endm 
			     C	 
			     C	; 打印以 '$' 结尾的字符串 
			     C	PRINTSTR macro msg 
			     C	    mov dx, offset msg 
			     C	    mov ah, 09h 
			     C	    int 21h 
			     C	endm 
			     C	 
			     C	; 换行 
			     C	NEWLINE macro 
			     C	    PRINTSTR crlf 
			     C	endm 
				 
				 
				        extrn year:word, month:word, first:word
				, ndays:word 
				        extrn mdays:byte 
				 
