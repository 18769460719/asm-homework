				; input.asm —— 作业7：输入模块 
				; 提供两个远过程：read_year / read_mont
				h 
				; 两者都从键盘逐字符读，数字回显
				，回车结束；非法输入会提示重来�
				� 
				; DS 由 main 设好，本模块只按 EXTRN �
				�偏移访问数据段。 
				 
				        include macros.inc 
			     C	; macros.inc —— 作业7 公共宏定义 
			     C	; 宏汇编：把常用的一段指令序列起
				个名字，展开时直接替换成指令， 
			     C	; 不产生 call/ret 的开销，也不占额�
				�的代码段。 
			     C	 
			     C	; 保存/恢复常用寄存器（打印类过�
				�里反复用到） 
			     C	PUSHALL macro 
			     C	    push ax 
			     C	    push bx 
			     C	    push cx 
			     C	    push dx 
			     C	    push si 
			     C	    push di 
			     C	endm 
			     C	 
			     C	POPALL macro 
			     C	    pop di 
			     C	    pop si 
			     C	    pop dx 
			     C	    pop cx 
			     C	    pop bx 
			     C	    pop ax 
			     C	endm 
			     C	 
			     C	; 打印以 '$' 结尾的字符串 
			     C	PRINTSTR macro msg 
			     C	    mov dx, offset msg 
			     C	    mov ah, 09h 
			     C	    int 21h 
			     C	endm 
			     C	 
			     C	; 换行 
			     C	NEWLINE macro 
			     C	    PRINTSTR crlf 
			     C	endm 
				 
				 
				        extrn year:word, month:word 
				        extrn p_year:byte, p_mon:byte, badmsg:b
				yte, crlf:byte 
				 
