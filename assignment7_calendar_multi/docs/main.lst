				; main.asm —— 作业7：多模块输出日�
				��（主模块） 
				; 本模块只做三件事：建立数据段/�
				�栈、按顺序调用各功能模块、退出�
				�� 
				; 其它模块：input.asm（输入）、calc.a
				sm（日期计算）、print.asm（输出）。
				 
				; 汇编：MASM 5.0  链接：LINK 3.60  运行
				：DOSBox 
				 
				        include macros.inc 
			     C	; macros.inc —— 作业7 公共宏定义 
			     C	; 宏汇编：把常用的一段指令序列起
				个名字，展开时直接替换成指令， 
			     C	; 不产生 call/ret 的开销，也不占额�
				�的代码段。 
			     C	 
			     C	; 保存/恢复常用寄存器（打印类过�
				�里反复用到） 
			     C	PUSHALL macro 
			     C	    push ax 
			     C	    push bx 
			     C	    push cx 
			     C	    push dx 
			     C	    push si 
			     C	    push di 
			     C	endm 
			     C	 
			     C	POPALL macro 
			     C	    pop di 
			     C	    pop si 
			     C	    pop dx 
			     C	    pop cx 
			     C	    pop bx 
			     C	    pop ax 
			     C	endm 
			     C	 
			     C	; 打印以 '$' 结尾的字符串 
			     C	PRINTSTR macro msg 
			     C	    mov dx, offset msg 
			     C	    mov ah, 09h 
			     C	    int 21h 
			     C	endm 
			     C	 
			     C	; 换行 
			     C	NEWLINE macro 
			     C	    PRINTSTR crlf 
			     C	endm 
				 
				 
				; ---------------- 公共数据段（各模块�
				��过 EXTRN 访问） ---------------- 
 0000				DATA    segment para public 'DATA' 
