				; print.asm —— 作业7：输出模块 
				; 对外三个远过程：print_title / print_h
				ead / print_body 
				; 内部有近过程 putc、print_dec、print_y
				ear。 
				; 这里用宏 PUSHALL/POPALL 保护寄存器�
				�用 NEWLINE 宏换行。 
				 
				        include macros.inc 
			     C	; macros.inc —— 作业7 公共宏定义 
			     C	; 宏汇编：把常用的一段指令序列起
				个名字，展开时直接替换成指令， 
			     C	; 不产生 call/ret 的开销，也不占额�
				�的代码段。 
			     C	 
			     C	; 保存/恢复常用寄存器（打印类过�
				�里反复用到） 
			     C	PUSHALL macro 
			     C	    push ax 
			     C	    push bx 
			     C	    push cx 
			     C	    push dx 
			     C	    push si 
			     C	    push di 
			     C	endm 
			     C	 
			     C	POPALL macro 
			     C	    pop di 
			     C	    pop si 
			     C	    pop dx 
			     C	    pop cx 
			     C	    pop bx 
			     C	    pop ax 
			     C	endm 
			     C	 
			     C	; 打印以 '$' 结尾的字符串 
			     C	PRINTSTR macro msg 
			     C	    mov dx, offset msg 
			     C	    mov ah, 09h 
			     C	    int 21h 
			     C	endm 
			     C	 
			     C	; 换行 
			     C	NEWLINE macro 
			     C	    PRINTSTR crlf 
			     C	endm 
				 
				 
				        extrn year:word, month:word, first:word
				, ndays:word 
				        extrn mnames:byte, crlf:byte, whead:byt
				e 
				 
